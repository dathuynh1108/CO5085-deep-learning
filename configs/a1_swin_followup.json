{
  "version": 2,
  "study": "A1 Swin-T initialization comparison with matched warmup and cosine schedule",
  "dataset": "CIFAR100",
  "classes": 100,
  "split_seed": 2026,
  "train_size": 45000,
  "val_size": 5000,
  "test_size": 10000,
  "seeds": [
    42,
    43,
    44
  ],
  "epochs": 40,
  "batch_size": 128,
  "image_size": 96,
  "train_transform": "RandomCrop(32,padding=4),RandomHorizontalFlip(0.5),Resize(96,bilinear,antialias=True),ToTensor,Normalize",
  "augmentation_rng": "SHA256(A1:train_seed:epoch:official_image_index); seeded CPU torch/Python/NumPy; workers nonpersistent",
  "eval_transform": "Resize(96,bilinear,antialias=True),ToTensor,Normalize",
  "mean": [
    0.485,
    0.456,
    0.406
  ],
  "std": [
    0.229,
    0.224,
    0.225
  ],
  "optimizer": "AdamW",
  "betas": [
    0.9,
    0.999
  ],
  "eps": 1e-08,
  "weight_decay": 0.01,
  "scheduler": "LinearLR from 0.1x to peak over 5 epochs, then CosineAnnealingLR to 0 over 35 epochs",
  "loss": "CrossEntropyLoss, no label smoothing",
  "gradient_clip": 1.0,
  "precision": "BF16 autocast; parameters and optimizer FP32; no GradScaler",
  "tf32": false,
  "compile": false,
  "selection": "maximum validation accuracy; tie minimum validation CE",
  "experiments": [
    {
      "id": "swin_t_scratch",
      "family": "swin_t",
      "regime": "scratch",
      "weights": null,
      "lr": 0.0002
    },
    {
      "id": "swin_t_full",
      "family": "swin_t",
      "regime": "full",
      "weights": "Swin_T_Weights.IMAGENET1K_V1",
      "lr": 0.0002
    }
  ],
  "warmup_epochs": 5
}
